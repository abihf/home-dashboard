[Unit]
Description=Home Dashboard Server
After=network.target
Before=graphical.target

[Service]
WorkingDirectory=/home/abi/play/js/home-dashboard
# background images are not embedded in the executable; they are read from BG_DIR at runtime
Environment=BG_DIR=/home/abi/play/js/home-dashboard/assets/bg
ExecStart=/home/abi/play/js/home-dashboard/build/server
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=homedashboard
User=abi
Group=root


[Install]
WantedBy=multi-user.target
